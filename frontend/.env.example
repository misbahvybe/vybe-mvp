# API URL (required – point to your backend)
# Local: http://localhost:4000/api/v1
# Production: https://vybe-mvp-production.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PWA manifest (optional). On Vercel, omit or leave unset to avoid linking /manifest.json
# (Deployment Protection often returns 401 for that file). Set to "true" only if you want PWA
# install + your deployment allows unauthenticated access to /manifest.json.
# NEXT_PUBLIC_ENABLE_PWA_MANIFEST=true
# Or disable everywhere: SKIP_PWA_MANIFEST=1

# Stripe (optional – for card payments; omit to use COD only)
# Get from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Geoapify Geocoding API (optional): reverse + forward search; omit = coordinates-only fallback
NEXT_PUBLIC_GEOAPIFY_API_KEY=
