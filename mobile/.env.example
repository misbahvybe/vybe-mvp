# Optional – reverse geocode when customer pins on map (same key as web NEXT_PUBLIC_GEOAPIFY_API_KEY).
# Without it, saved address text uses raw coordinates; riders can still open Maps with lat/lng.
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Android release maps (react-native-maps). Set the same name in EAS Secrets for cloud builds.
# GOOGLE_MAPS_ANDROID_API_KEY=
