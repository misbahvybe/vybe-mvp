generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Non-pooler URL (Neon: “direct” host without `-pooler`). Required for `migrate deploy` — PgBouncer advisory locks often time out (P1002).
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum Role {
  CUSTOMER
  RIDER
  STORE_OWNER
  ADMIN
}

enum PaymentMethod {
  COD
  CARD
  MANUAL_TRANSFER
}

enum PaymentStatus {
  /// Awaiting user upload (manual) or not yet collected (COD).
  PENDING
  /// User submitted payment screenshot; admin has not decided yet.
  PENDING_VERIFICATION
  PAID
}

enum PendingPaymentProvider {
  XPAY
  JAZZCASH
  EASYPAISA
  /// Placeholders for HBL / Meezan / Allied redirect integrations (see BankPaymentsModule).
  BANK_HBL
  BANK_MEEZAN
  BANK_ALLIED
  /// MVP manual “bank transfer” (IBAN / account shown in-app; no redirect API).
  BANK_MANUAL
}

enum OrderStatus {
  PENDING
  STORE_ACCEPTED
  STORE_REJECTED
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  RIDER_ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum CancellationReason {
  CUSTOMER_CANCELLED
  STORE_REJECTED
  ADMIN_CANCELLED
  OUT_OF_STOCK
  STORE_CLOSED
  OTHER
}

enum StoreStatus {
  /// Store was invited/created by admin; owner has not completed signup yet.
  INVITED
  /// Store is live and can receive orders / show menu to customers.
  ACTIVE
  /// Store is disabled by admin (hidden from customers).
  INACTIVE
}

/// How the platform service fee is calculated at checkout.
enum CheckoutServiceFeeMode {
  FIXED
  PERCENT
}

/// Heuristic category for pharmacy SKUs (from name or import metadata).
enum MedicineFormHint {
  TABLET
  SYRUP
  CAPSULE
  INJECTION
  OTHER
}

// ═══════════════════════════════════════════════════════════════════════════════
// 1️⃣ USERS
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String?   @unique
  phone                String    @unique
  password             String?   // hashed
  role                 Role      @default(CUSTOMER)
  isVerified           Boolean   @default(false) @map("is_verified")
  isActive             Boolean   @default(true) @map("is_active")
  /// When set and in the future, recent checkout OTP (WhatsApp) was verified; required when VYBE_CHECKOUT_OTP is enabled.
  checkoutOtpVerifiedUntil DateTime? @map("checkout_otp_verified_until")
  /// Set when abuse thresholds hit (cancellations, etc.); new orders are rejected while true.
  isOrderingBlocked     Boolean  @default(false) @map("is_ordering_blocked")
  /// Incremented on suspicious cancellations while order was still PENDING; used with VYBE_ORDER_STRIKES.
  orderStrikeCount      Int      @default(0) @map("order_strike_count")
  passwordSet          Boolean   @default(false) @map("password_set")
  invitationToken      String?   @map("invitation_token")
  invitationExpiresAt  DateTime? @map("invitation_expires_at")
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  addresses     Address[]
  paymentMethods SavedPaymentMethod[]
  ordersAsCustomer Order[]     @relation("CustomerOrders")
  ordersAsRider    Order[]      @relation("RiderOrders")
  riderProfile    RiderProfile?
  ownedStores     Store[]       @relation("StoreOwner")
  riderEarnings    RiderEarning[]
  adminLogs        AdminLog[]   @relation("AdminLogs")
  pendingPayments  PendingPayment[]
  withdrawRequests WithdrawRequest[]
  earningPayouts    EarningPayout[]
  orderRiderChanges OrderRiderChange[] @relation("OrderRiderChangeAdmin")
  notifications     Notification[]
  webPushSubscriptions WebPushSubscription[]

  @@index([phone])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 2️⃣ OTP
// ═══════════════════════════════════════════════════════════════════════════════

model Otp {
  id        String   @id @default(uuid())
  phone     String
  code      String   // hashed
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, expiresAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 2️⃣b SAVED PAYMENT METHODS (cards)
// ═══════════════════════════════════════════════════════════════════════════════

model SavedPaymentMethod {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  providerId  String   @map("provider_id")   // Stripe pm_xxx or internal id for dev
  last4       String
  brand       String   // Visa, Mastercard
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 3️⃣ ADDRESSES
// ═══════════════════════════════════════════════════════════════════════════════

model Address {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  label      String?
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  fullAddress String  @map("full_address")
  city       String   @default("Lahore")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[] @relation("DeliveryAddress")

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 4️⃣ STORES
// ═══════════════════════════════════════════════════════════════════════════════

model Store {
  id           String   @id @default(uuid())
  ownerId      String   @map("owner_id")
  name         String
  description  String?
  imageUrl     String?  @map("image_url")
  phone        String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  address      String?
  city         String   @default("Lahore")
  status       StoreStatus @default(ACTIVE) @map("store_status")
  isApproved   Boolean  @default(false) @map("is_approved")
  isOpen       Boolean  @default(true) @map("is_open")
  /// When false, store stays visible but new orders are blocked (kitchen busy / manual pause).
  acceptingOrders Boolean @default(true) @map("accepting_orders")
  openingTime  String?  @map("opening_time")   // HH:mm e.g. "09:00"
  closingTime  String?  @map("closing_time")   // HH:mm e.g. "22:00"
  /// Optional custom commission % for this store only (0–100). If null, category default applies.
  commissionPercentOverride Decimal? @map("commission_percent_override") @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner             User              @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  products          Product[]
  productCategories ProductCategory[]
  orders            Order[]
  categories        StoreToCategory[]
  earnings          StoreEarning[]
  earningPayouts    EarningPayout[]

  @@index([city])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 5️⃣ STORE CATEGORIES
// ═══════════════════════════════════════════════════════════════════════════════

model StoreCategory {
  id   String @id @default(uuid())
  name String @unique

  stores StoreToCategory[]
}

/// Default platform commission % per vertical (slug = StoreCategory.name: food, grocery, medicine).
model PlatformCategoryCommission {
  id                String   @id @default(uuid())
  categorySlug      String   @unique @map("category_slug")
  commissionPercent Decimal  @map("commission_percent") @db.Decimal(5, 2)
  updatedAt         DateTime @updatedAt @map("updated_at")
}

/// Singleton row (`id = "default"`): customer checkout service fee + COD tax % (admin-editable).
model PlatformCheckoutSettings {
  id String @id @default("default")

  serviceFeeMode CheckoutServiceFeeMode @default(FIXED) @map("service_fee_mode")
  /// When mode is FIXED: flat amount (e.g. PKR). When PERCENT: ignored.
  serviceFeeFixed Decimal @default(19.99) @map("service_fee_fixed") @db.Decimal(10, 2)
  /// When mode is PERCENT: applied to (subtotal + delivery fee), before COD tax. When FIXED: ignored.
  serviceFeePercent Decimal @default(0) @map("service_fee_percent") @db.Decimal(5, 2)
  /// COD-only tax as a percent (e.g. 16 = 16%) on (subtotal + delivery + service fee).
  codTaxPercent Decimal @default(16) @map("cod_tax_percent") @db.Decimal(5, 2)
  /// When false, COD tax is treated as 0 regardless of percent.
  codTaxEnabled Boolean @default(false) @map("cod_tax_enabled")

  /// Delivery pricing (base per km) and simple peak rules.
  deliveryBasePerKm Decimal @default(45) @map("delivery_base_per_km") @db.Decimal(10, 2)
  /// Multiplier applied on weekends (Sat/Sun) e.g. 1.4 = +40%. Set 1 to disable.
  weekendMultiplier Decimal @default(1) @map("weekend_multiplier") @db.Decimal(6, 3)
  /// Multiplier applied in peak hours window e.g. 1.6 = +60%. Set 1 to disable.
  peakMultiplier Decimal @default(1) @map("peak_multiplier") @db.Decimal(6, 3)
  /// Peak window start (HH:mm, Pakistan local time).
  peakStartTime String @default("18:00") @map("peak_start_time")
  /// Peak window end (HH:mm, Pakistan local time). If <= start, window wraps overnight.
  peakEndTime String @default("22:00") @map("peak_end_time")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_checkout_settings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String?
  dataJson  String?  @map("data_json")
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 🔔 WEB PUSH SUBSCRIPTIONS (PWA push notifications)
// ═══════════════════════════════════════════════════════════════════════════════

model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String   @map("p256dh")
  auth      String   @map("auth")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model StoreToCategory {
  storeId    String @map("store_id")
  categoryId String @map("category_id")

  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category StoreCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([storeId, categoryId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 5️⃣b PRODUCT CATEGORIES (per store: Beverages, Snacks, etc.)
// ═══════════════════════════════════════════════════════════════════════════════

model ProductCategory {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 6️⃣ PRODUCTS
// ═══════════════════════════════════════════════════════════════════════════════

model Product {
  id                 String   @id @default(uuid())
  storeId            String   @map("store_id")
  productCategoryId  String?  @map("product_category_id")
  name               String
  description        String?
  price              Decimal  @db.Decimal(10, 2)
  stock              Decimal  @default(999) @db.Decimal(10, 2)
  isOutOfStock       Boolean  @default(false) @map("is_out_of_stock")
  imageUrl           String?  @map("image_url")
  isAvailable        Boolean  @default(true) @map("is_available")
  /// Draft / unverified catalog rows (e.g. reference import). Hidden from customers until verified.
  isDraft            Boolean  @default(false) @map("is_draft")
  /// Set false for imported reference data until pharmacy confirms.
  isVerified         Boolean  @default(true) @map("is_verified")
  /// Lowercase single-spaced name for deduplication within a store.
  nameNormalized     String   @default("") @map("name_normalized")
  /// e.g. manual | csv | reference_seed
  source             String?  @map("source")
  formHint           MedicineFormHint? @map("form_hint")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category         ProductCategory? @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  orderItems       OrderItem[]

  @@index([storeId, nameNormalized])
  @@index([storeId, isDraft])
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  name        String
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true) @map("is_available")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@unique([productId, name])
}


// ═══════════════════════════════════════════════════════════════════════════════
// 7️⃣ ORDERS
// ═══════════════════════════════════════════════════════════════════════════════

model Order {
  id               String        @id @default(uuid())
  /// Human-friendly incremental order number (1,2,3...). Used for POS/admin displays.
  orderNumber      Int           @unique @default(autoincrement()) @map("order_number")
  customerId       String        @map("customer_id")
  storeId         String        @map("store_id")
  riderId          String?       @map("rider_id")
  addressId       String        @map("address_id")
  subtotalAmount   Decimal       @map("subtotal_amount") @db.Decimal(10, 2)
  deliveryFee      Decimal       @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  serviceFee       Decimal       @default(0) @map("service_fee") @db.Decimal(10, 2)
  /// COD: configurable % on (subtotal + delivery + service). Card: 0.
  gstAmount        Decimal       @default(0) @map("gst_amount") @db.Decimal(10, 2)
  /// Card: 5% processing on (subtotal + delivery + service). COD: 0.
  cardProcessingAmount Decimal   @default(0) @map("card_processing_amount") @db.Decimal(10, 2)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(10, 2)
  commissionAmount Decimal       @default(0) @map("commission_amount") @db.Decimal(10, 2)
  /// Commission % applied to subtotal at checkout (snapshot).
  commissionPercentSnapshot Decimal? @map("commission_percent_snapshot") @db.Decimal(5, 2)
  deliveryDistanceKm Decimal?    @map("delivery_distance_km") @db.Decimal(10, 4)
  /// Target completion time for SLA countdown (e.g. placedAt + 45m).
  slaDeadlineAt    DateTime?     @map("sla_deadline_at")
  paymentMethod   PaymentMethod  @default(COD) @map("payment_method")
  paymentStatus   PaymentStatus  @default(PENDING) @map("payment_status")
  /// JazzCash / Easypaisa / bank (MVP) when `paymentMethod` is MANUAL_TRANSFER.
  manualTransferProvider PendingPaymentProvider? @map("manual_transfer_provider")
  /// Customer-uploaded proof (screenshot) for manual MVP payments.
  paymentScreenshotUrl String?  @map("payment_screenshot_url")
  orderStatus     OrderStatus   @default(PENDING) @map("order_status")
  /// True when rider claimed from READY_FOR_PICKUP pool (not admin-assigned).
  riderSelfAssigned Boolean     @default(false) @map("rider_self_assigned")
  /// Set when rider confirms they are at the pickup location (required before marking picked up).
  riderArrivedAt  DateTime?     @map("rider_arrived_at")
  notes           String?
  cancellationReason CancellationReason? @map("cancellation_reason")
  cancelledByRole Role?         @map("cancelled_by_role")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer  User         @relation("CustomerOrders", fields: [customerId], references: [id])
  store     Store        @relation(fields: [storeId], references: [id])
  rider     User?        @relation("RiderOrders", fields: [riderId], references: [id])
  address   Address      @relation("DeliveryAddress", fields: [addressId], references: [id])
  items     OrderItem[]
  riderEarning RiderEarning?
  storeEarning StoreEarning?
  statusHistory OrderStatusHistory[]
  riderChanges OrderRiderChange[] @relation("OrderRiderChanges")

  @@index([customerId])
  @@index([storeId])
  @@index([riderId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 7️⃣b ORDER STATUS HISTORY
// ═══════════════════════════════════════════════════════════════════════════════

model OrderStatusHistory {
  id            String      @id @default(uuid())
  orderId       String      @map("order_id")
  status        OrderStatus
  changedByUserId String?   @map("changed_by_user_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 7️⃣c ORDER RIDER CHANGES (admin reassign)
// ═══════════════════════════════════════════════════════════════════════════════

model OrderRiderChange {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  adminId     String   @map("admin_id")
  oldRiderId  String?  @map("old_rider_id")
  newRiderId  String?  @map("new_rider_id")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation("OrderRiderChanges", fields: [orderId], references: [id], onDelete: Cascade)
  admin User  @relation("OrderRiderChangeAdmin", fields: [adminId], references: [id])

  @@index([orderId])
  @@index([adminId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 8️⃣ ORDER ITEMS
// ═══════════════════════════════════════════════════════════════════════════════

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  variantId String? @map("variant_id")
  variantNameSnapshot String? @map("variant_name_snapshot")
  quantity  Decimal @db.Decimal(10, 2)
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 9️⃣ RIDER PROFILE
// ═══════════════════════════════════════════════════════════════════════════════

model RiderProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  vehicleType   String   @default("Bike") @map("vehicle_type")
  vehicleNumber String? @map("vehicle_number")
  isAvailable   Boolean  @default(true) @map("is_available")
  currentLatitude  Decimal? @map("current_latitude") @db.Decimal(10, 7)
  currentLongitude Decimal? @map("current_longitude") @db.Decimal(10, 7)
  /// Cash collected from COD deliveries not yet deposited with admin (PKR).
  currentCollectedAmount Decimal @default(0) @map("current_collected_amount") @db.Decimal(10, 2)
  /// True when `currentCollectedAmount` >= platform limit — no new pickup assignments until admin settles.
  isBlocked   Boolean  @default(false) @map("is_blocked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════════════════════
// 🔟 RIDER EARNINGS
// ═══════════════════════════════════════════════════════════════════════════════

model RiderEarning {
  id           String   @id @default(uuid())
  riderId      String   @map("rider_id")
  orderId      String   @unique @map("order_id")
  earningAmount Decimal @map("earning_amount") @db.Decimal(10, 2)
  isPaid       Boolean  @default(false) @map("is_paid")
  createdAt    DateTime @default(now()) @map("created_at")

  rider User  @relation(fields: [riderId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 1️⃣1️⃣ STORE EARNINGS
// ═══════════════════════════════════════════════════════════════════════════════

model StoreEarning {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  orderId           String   @unique @map("order_id")
  storeAmount       Decimal  @map("store_amount") @db.Decimal(10, 2)      // store gets this
  commissionAmount  Decimal  @map("commission_amount") @db.Decimal(10, 2) // platform earning
  isSettled          Boolean  @default(false) @map("is_settled")
  createdAt         DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 1️⃣2️⃣ PENDING PAYMENT (XPay redirect flow)
// ═══════════════════════════════════════════════════════════════════════════════

model PendingPayment {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  storeId      String   @map("store_id")
  addressId    String   @map("address_id")
  itemsJson    String   @map("items_json")   // JSON: [{productId, quantity, price}]
  amountPkr    Decimal  @map("amount_pkr") @db.Decimal(10, 2)
  xpayIntentId String?  @map("xpay_intent_id")
  provider     PendingPaymentProvider @default(XPAY) @map("provider")
  providerRef  String?  @map("provider_ref") // e.g. pp_TxnRefNo (JazzCash) / orderRef
  providerPayloadJson String? @map("provider_payload_json") // raw gateway response (JSON)
  orderId      String?  @map("order_id")
  status       String   @default("PENDING")  // PENDING | COMPLETED | EXPIRED
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status, expiresAt])
  @@index([provider, providerRef])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 1️⃣3️⃣ ADMIN LOGS
// ═══════════════════════════════════════════════════════════════════════════════

model AdminLog {
  id       String   @id @default(uuid())
  adminId  String   @map("admin_id")
  action   String
  targetId String? @map("target_id")
  createdAt DateTime @default(now()) @map("created_at")

  admin User @relation("AdminLogs", fields: [adminId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════════════
// 1️⃣4️⃣ WITHDRAW REQUESTS (riders & stores)
// ═══════════════════════════════════════════════════════════════════════════════

model WithdrawRequest {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  role        Role
  amount      Decimal  @db.Decimal(10, 2)
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED | PAID
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  earningPayout EarningPayout?

  @@index([userId])
  @@index([status])
}

/// Money sent to rider/store (withdrawal settled). Reduces available balance vs raw order earnings.
model EarningPayout {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  role              Role
  storeId           String?  @map("store_id")
  amountPkr         Decimal  @map("amount_pkr") @db.Decimal(10, 2)
  withdrawRequestId String   @unique @map("withdraw_request_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  store             Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  withdrawRequest   WithdrawRequest  @relation(fields: [withdrawRequestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storeId])
  @@map("earning_payouts")
}
