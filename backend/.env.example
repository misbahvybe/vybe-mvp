# ═══════════════════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════════════════
# App traffic: Neon pooler URL is fine (host contains `-pooler`).
# Never use a connection string whose database name is prisma_migrate_shadow_db_* (Prisma dev shadow DB only).
DATABASE_URL="postgresql://user:password@host:5432/vybe?sslmode=require"
# Migrations / prisma migrate: use Neon “direct” connection (same user/db, host WITHOUT `-pooler`).
# If omitted or same as pooler, `migrate deploy` can fail with P1002 (advisory lock timeout).
# Local Postgres: set DIRECT_URL to the same value as DATABASE_URL.
# Railway: optional — npm/Docker scripts default DIRECT_URL to DATABASE_URL if unset.
# Neon (pooler + direct): set DATABASE_URL to pooler and DIRECT_URL to the non-pooler host.
DIRECT_URL="postgresql://user:password@direct-host:5432/vybe?sslmode=require"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
# Comma-separated allowed origins; all https://*.vercel.app are also allowed for previews.
FRONTEND_URL=http://localhost:3000
# Optional extra allowed CORS origins (comma-separated), e.g. another marketing domain on Railway/Vercel.
# CORS_EXTRA_ORIGINS=

# ═══════════════════════════════════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════════════════════════════════
JWT_EXPIRES_IN=30d
# Wall-clock timezone for store opening hours (isOpenNow, ordering). Default Pakistan.
# BUSINESS_TIMEZONE=Asia/Karachi
OTP_EXPIRY_MINUTES=3
OTP_MAX_ATTEMPTS=5
PORT=4000

# Public origin of this API (no path) — used for local-disk image URLs only (when Cloudinary is off). Example: https://your-app.up.railway.app
# API_PUBLIC_URL=

# Cloudinary (recommended on Railway — disk is ephemeral; without this, /uploads/... returns 404 after restart)
# Option A — one line from Cloudinary dashboard → API Keys → "Copy API environment variable":
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Option B — three variables:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# OTP via WhatsApp (Meta Cloud API) – required for production OTP delivery
# Create a template in Meta Business Manager with body {{1}} = OTP code (optional {{2}} = minutes if WHATSAPP_OTP_TEMPLATE_MINUTES_PARAM=true)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
# Optional: API version, template language, auth template URL button index ("0"), second body param for expiry minutes
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_OTP_AUTH_BUTTON_INDEX=0
# WHATSAPP_OTP_TEMPLATE_MINUTES_PARAM=true

# Geoapify Geocoding API: forward search + reverse (optional; one key for both)
GEOAPIFY_API_KEY=

# Stripe (optional – card payments; omit = COD only)
STRIPE_SECRET_KEY=sk_test_xxx

# XPay Pakistan (optional – card/wallet payments; omit = COD only)
# Get from https://www.xpay.postexglobal.com/
XPAY_API_KEY=
XPAY_ACCOUNT_ID=
XPAY_SECRET=
XPAY_TEST=true
XPAY_BASE_URL=https://xstak-pay-stg.xstak.com
XPAY_GATEWAY_INSTANCE_ID=
BACKEND_URL=http://localhost:4000

# Upstash Redis (optional — HTTP cache / rate buckets / feed snapshots; omit = cache no-ops)
# Create a database at https://upstash.com → copy REST URL + token
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Cache TTLs (seconds)
# STORE_LIST_CACHE_TTL_SECONDS=60
# ADMIN_METRICS_CACHE_TTL_SECONDS=45
# ADMIN_METRICS_CHARTS_CACHE_TTL_SECONDS=120

# Manual MVP: in-app bank / wallet numbers + customer screenshot (no live gateway). See manual-mvp.util.ts
# VYBE_MANUAL_MVP=1
# First order must be paid online until one delivery completes (use VYBE_ALLOW_COD_ON_FIRST_ORDER=1 to allow COD for new customers).
# Note: With PAYMENTS_COD_ONLY in code (no card/JazzCash checkout), if manual MVP is OFF, first-order COD is allowed automatically so users are not stuck.
# VYBE_ALLOW_COD_ON_FIRST_ORDER=1
# First N placed (non-cancelled) orders get free delivery — see delivery lines on quote
# VYBE_FREE_DELIVERY_ORDER_COUNT=2
# VYBE_CHECKOUT_OTP=1
# Customer cancels while PENDING → strikes; default 5 then isOrderingBlocked (set 0 to disable)
# VYBE_ORDER_STRIKES_MAX=5
# VYBE_MVP_JAZZCASH_NUMBER=
# VYBE_MVP_JAZZCASH_TITLE=
# VYBE_MVP_JAZZCASH_APP_URL=jazzcash://
# VYBE_MVP_EASYPAISA_NUMBER=
# VYBE_MVP_EASYPAISA_TITLE=
# VYBE_MVP_EASYPAISA_APP_URL=https://easypaisa.com.pk/
# Bank (MCB, etc.): account title, local account #, and IBAN — both shown to customers for BANK_MANUAL
# VYBE_MVP_BANK_TITLE=Account holder (Bank name)
# VYBE_MVP_BANK_NAME=MCB
# VYBE_MVP_BANK_ACCOUNT=
# VYBE_MVP_BANK_IBAN=

# POS: optional legacy override — auto-accept stays ON if this is true OR admin enables it under Admin → Orders (DB).
# Prefer the admin UI toggle; remove this env if you want the database setting to fully control on/off.
# VYBE_POS_AUTO_ACCEPT_ORDERS=0

# Order pricing (optional — sensible defaults in code)
# DELIVERY_FEE_PER_KM=45
# MIN_SERVICE_FEE_PKR=19.99
# COD_GST_RATE=0.18
# Optional: non-COD “online” surcharge (fraction of subtotal+delivery+service), e.g. 0.05 = 5%. Default in code is 0 (off) until you add GST / fees.
# CARD_PROCESSING_RATE=0
# DELIVERY_ROAD_DISTANCE_FACTOR=1.2
# DEFAULT_COMMISSION_PERCENT=15
# ORDER_SLA_MINUTES=45
# GOOGLE_MAPS_API_KEY=
