# ═══════════════════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════════════════
DATABASE_URL="postgresql://user:password@host:5432/vybe?sslmode=require"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
FRONTEND_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════════════════════════════════
JWT_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=3
OTP_MAX_ATTEMPTS=5
PORT=4000

# Public origin of this API (no path) — used in uploaded image URLs. Example: https://your-app.up.railway.app
# API_PUBLIC_URL=

# OTP via WhatsApp (Meta Cloud API) – required for production OTP delivery
# Create a template in Meta Business Manager with body {{1}} = OTP code (optional {{2}} = minutes if WHATSAPP_OTP_TEMPLATE_MINUTES_PARAM=true)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
# Optional: API version, template language, auth template URL button index ("0"), second body param for expiry minutes
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_OTP_AUTH_BUTTON_INDEX=0
# WHATSAPP_OTP_TEMPLATE_MINUTES_PARAM=true

# Geocoding for address picker (optional)
GEOAPIFY_API_KEY=

# Stripe (optional – card payments; omit = COD only)
STRIPE_SECRET_KEY=sk_test_xxx

# XPay Pakistan (optional – card/wallet payments; omit = COD only)
# Get from https://www.xpay.postexglobal.com/
XPAY_API_KEY=
XPAY_ACCOUNT_ID=
XPAY_SECRET=
XPAY_TEST=true
XPAY_BASE_URL=https://xstak-pay-stg.xstak.com
XPAY_GATEWAY_INSTANCE_ID=
BACKEND_URL=http://localhost:4000

# Order pricing (optional — sensible defaults in code)
# DELIVERY_FEE_PER_KM=45
# MIN_SERVICE_FEE_PKR=19.99
# COD_GST_RATE=0.18
# CARD_PROCESSING_RATE=0.05
# DELIVERY_ROAD_DISTANCE_FACTOR=1.2
# DEFAULT_COMMISSION_PERCENT=15
# ORDER_SLA_MINUTES=45
# GOOGLE_MAPS_API_KEY=
