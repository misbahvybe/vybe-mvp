# Copy this file to the repo root as `.env` (same folder as `frontend/` and `backend/`).
# Used by: python scripts/import_kaggle_pakistan_medicines.py
#
# Vybe API (required for real import; not needed for --dry-run after Kaggle works)
VYBE_API_BASE_URL=https://your-host.up.railway.app/api/v1
VYBE_ADMIN_TOKEN=

# Optional: instead of %USERPROFILE%\.kaggle\kaggle.json
KAGGLE_USERNAME=
KAGGLE_KEY=
